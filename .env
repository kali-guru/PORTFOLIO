# Committed public defaults (no secrets — everything here ships in the client bundle).
# Override per environment, e.g.: VITE_SITE_URL=https://your-domain.com npm run build
# Local secrets-free overrides go in `.env.local` (gitignored).

VITE_SITE_URL=https://example.com
VITE_GITHUB_URL=https://github.com/kali-guru
VITE_LINKEDIN_URL=https://linkedin.com/in/[YOUR_LINKEDIN]
VITE_CONTACT_EMAIL=[YOUR EMAIL]
