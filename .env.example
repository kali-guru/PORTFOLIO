# Public, build-time configuration only.
# WARNING: Vite exposes every VITE_* variable in the client bundle.
# NEVER put secrets, API keys, or tokens here.

# Canonical site URL used for SEO (canonical link, OG tags, sitemap base).
# Replace with your production domain, no trailing path.
VITE_SITE_URL=https://example.com

# Public contact / profile links (all optional).
VITE_GITHUB_URL=https://github.com/kali-guru
VITE_LINKEDIN_URL=https://linkedin.com/in/[YOUR_LINKEDIN]
VITE_CONTACT_EMAIL=[YOUR EMAIL]
